# 运行环境 development | production
APP_ENV=development
# API 监听地址。默认仅本机；如需局域网访问请自行改为 0.0.0.0 并配置访问控制
APP_HOST=127.0.0.1
APP_PORT=8000
# 前端来源（CORS），开发模式 Vite 端口
WEB_ORIGIN=http://127.0.0.1:5173
# SQLite 数据库
DATABASE_URL=sqlite:///./var/app.db
# 制品根目录（uploads/runs/models/hf-cache 均在其下）
ARTIFACT_ROOT=./var
# 上传限制
MAX_UPLOAD_MB=100
# 训练并发（第一版固定 1）
MAX_TRAINING_CONCURRENCY=1
# HuggingFace 缓存目录
HF_HOME=./var/hf-cache
# 是否在日志中记录 Query 原文（默认关闭，仅本地调试）
LOG_RAW_TEXT=false

# ---- Query 改写（修改方案 §4 / §5.3 / §9.4）----
# rewriter 服务地址（Docker 内网为 http://rewriter:8010）
REWRITER_URL=http://127.0.0.1:8010
# 生成超时（ms）；连续失败熔断阈值与打开时长
REWRITE_TIMEOUT_MS=90000
REWRITE_FAILURE_THRESHOLD=5
REWRITE_BREAKER_OPEN_SECONDS=30
# rewriter 服务自身参数（REWRITE_PROVIDER=local_qwen | stub）
REWRITE_PROVIDER=local_qwen
REWRITE_MODEL_ID=Qwen/Qwen3-0.6B
REWRITE_MAX_NEW_TOKENS=96
REWRITE_DEVICE=auto
REWRITE_PORT=8010

# ---- 外部模型 Provider（V1：智谱 GLM / OpenAI 兼容 API）----
# 凭据主密钥（32 字节 base64）：API Key 以 AES-256-GCM 加密落库。
# 生成：python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 只经未入库的 .env / 部署 Secret 注入，绝不写进 docker-compose.yml 或 Git。
# 未配置时仅本地 Qwen 可用，创建远程连接会返回 CREDENTIAL_ENCRYPTION_NOT_CONFIGURED。
REWRITE_CREDENTIAL_MASTER_KEY=
# 主密钥轮换时临时使用（python -m app.cli.rotate_rewrite_master_key）
REWRITE_CREDENTIAL_MASTER_KEY_NEXT=
# 本地开发接 Ollama 等私有地址的兼容端点时显式放开（UI 会标红）
REWRITE_ALLOW_PRIVATE_PROVIDER_URLS=false
