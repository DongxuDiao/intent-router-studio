# 运行环境 development | production
APP_ENV=development
# API 监听地址。默认仅本机；如需局域网访问请自行改为 0.0.0.0 并配置访问控制
APP_HOST=127.0.0.1
APP_PORT=8000
# 前端来源（CORS），开发模式 Vite 端口
WEB_ORIGIN=http://127.0.0.1:5173
# SQLite 数据库
DATABASE_URL=sqlite:///./var/app.db
# 制品根目录（uploads/runs/models/hf-cache 均在其下）
ARTIFACT_ROOT=./var
# 上传限制
MAX_UPLOAD_MB=100
# 训练并发（第一版固定 1）
MAX_TRAINING_CONCURRENCY=1
# HuggingFace 缓存目录
HF_HOME=./var/hf-cache
# 是否在日志中记录 Query 原文（默认关闭，仅本地调试）
LOG_RAW_TEXT=false

# ---- Query 改写（修改方案 §4 / §5.3 / §9.4）----
# rewriter 服务地址（Docker 内网为 http://rewriter:8010）
REWRITER_URL=http://127.0.0.1:8010
# 生成超时（ms）；连续失败熔断阈值与打开时长
REWRITE_TIMEOUT_MS=90000
REWRITE_FAILURE_THRESHOLD=5
REWRITE_BREAKER_OPEN_SECONDS=30
# rewriter 服务自身参数（REWRITE_PROVIDER=local_qwen | stub）
REWRITE_PROVIDER=local_qwen
REWRITE_MODEL_ID=Qwen/Qwen3-0.6B
REWRITE_MAX_NEW_TOKENS=96
REWRITE_DEVICE=auto
REWRITE_PORT=8010
